{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imadtbn.github.io/taalam/content/schema/book.schema.json",
  "title": "Taalam Algerian Educational Book",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bookId",
    "title",
    "curriculum",
    "grade",
    "language",
    "contentVersion",
    "units"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "bookId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string"
    },
    "curriculum": {
      "type": "string",
      "const": "algerian"
    },
    "grade": {
      "type": "string",
      "enum": ["primary-1", "preparatory"]
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en",
        "fr",
        "mixed"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "rtl",
        "ltr",
        "auto"
      ],
      "default": "rtl"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "publicationYear": {
          "type": [
            "integer",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "order",
        "lessons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "order",
        "activities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "instructions",
        "data",
        "media"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "audio",
            "video",
            "multiple-choice",
            "true-false",
            "matching",
            "ordering",
            "fill-blank",
            "drawing"
          ]
        },
        "instructions": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "src"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "image",
                  "audio",
                  "video"
                ]
              },
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "sourcePage": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
